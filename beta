-- ===== Egg Filters =====
local AreaWanted = {}
local AreaWantedCount = 0
local RarityWanted = {}
local RarityWantedCount = 0
local TriedUids = {}
local FailUids = {}

-- ===== Egg List =====
local EggListCache = {}
local EggListAt = 0

local function GetHitboxPart(uid)
    local container = Workspace:FindFirstChild("AreaEggSlotsClient")
    container = container and container:FindFirstChild(uid)
    if not container then return nil end
    return container.PrimaryPart or container:FindFirstChild("Hitbox") or container:FindFirstChildWhichIsA("BasePart")
end

local function HasMutation(rec)
    if rec.BaseMutation then return true end
    return type(rec.Mutations) == "table" and next(rec.Mutations) ~= nil
end

local function GetEggList(force)
    if not force and tick() - EggListAt < 1.5 then return EggListCache end
    local snap = InvokeRemote("EggSnapshot")
    if not snap or type(snap.Records) ~= "table" then return EggListCache end
    local list = {}
    for uid, rec in pairs(snap.Records) do
        if rec.State == "Slot" and rec.Uid then
            local part = GetHitboxPart(rec.Uid)
            local pos = part and part.Position
                or (rec.BoundsCFrame and rec.BoundsCFrame.Position)
                or (rec.BottomCFrame and rec.BottomCFrame.Position)
            if pos then
                local areaId = rec.AreaId
                if areaId and not AreaLabels[areaId] then
                    RegisterArea(areaId, areaId, #AreaOrder + 1, nil)
                end
                local rarityName = rec.RarityName or rec.Rarity or rec.Tier
                if type(rarityName) == "table" then rarityName = rarityName.DisplayName or rarityName._id end
                if not rarityName then rarityName = AreaTierNames[areaId] end
                if RarityRank(rarityName) == 0 then rarityName = nil end
                table.insert(list, {
                    uid = rec.Uid,
                    area = areaId,
                    label = areaId and AreaLabels[areaId] or "Unknown",
                    pos = pos,
                    tier = areaId and AreaRarities[areaId] or 0,
                    rarity = rarityName,
                    rank = RarityRank(rarityName),
                    mutated = HasMutation(rec),
                    size = rec.BoundsSize and rec.BoundsSize.Magnitude or 3,
                })
            end
        end
    end
    EggListCache = list
    EggListAt = tick()
    return list
end

local function PassFilter(egg)
    local tried = TriedUids[egg.uid]
    if tried then
        local fails = FailUids[egg.uid] or 0
        local wait = 6
        if fails >= 4 then wait = 600
        elseif fails == 3 then wait = 120
        elseif fails == 2 then wait = 45
        elseif fails == 1 then wait = 18 end
        if wait > tick() - tried then return false end
    end
    if AreaWantedCount > 0 then return AreaWanted[egg.area] == true end
    if egg.rank >= (RarityLadder.Secret or 8) then return true end
    if RarityWantedCount > 0 and not RarityWanted[egg.rarity] then return false end
    return true
end

local function SelectBestEgg()
    local hrp = GetCurrentHRP()
    if not hrp then return nil end
    local list = GetEggList(false)
    local pos = hrp.Position
    local best, bestScore = nil, nil
    for _, e in ipairs(list) do
        if PassFilter(e) then
            local d = (e.pos - pos).Magnitude
            local tierOrRank = e.tier > 0 and e.tier or e.rank
            local score = e.rank * 1e12 + tierOrRank * 1e8 + (e.mutated and 1e6 or 0) - math.min(d, 1e5)
            if not bestScore or score > bestScore then
                bestScore = score
                best = e
            end
        end
    end
    return best
end

