local function PlaceEggAtSavedBase(uid, baseCFrame)
    local hrp = GetCurrentHRP()
    if not hrp or not baseCFrame then return false end

    local placeRemote = GetRemote("EggPlace")
    if placeRemote then
        local localCF = baseCFrame:Inverse() * hrp.CFrame
        local args = { Uid = uid, LocalCFrame = localCF }
        if placeRemote:IsA("RemoteFunction") then
            pcall(function() placeRemote:InvokeServer(args) end)
        else
            pcall(function() placeRemote:FireServer(args) end)
        end
        task.wait(0.15)
        if not HasItemAcquired() then return true end

        for _, off in ipairs({
            CFrame.new(2, 0, 0), CFrame.new(-2, 0, 0),
            CFrame.new(0, 0, 2), CFrame.new(0, 0, -2),
        }) do
            local args2 = { Uid = uid, LocalCFrame = off }
            if placeRemote:IsA("RemoteFunction") then
                pcall(function() placeRemote:InvokeServer(args2) end)
            else
                pcall(function() placeRemote:FireServer(args2) end)
            end
            task.wait(0.12)
            if not HasItemAcquired() then return true end
        end
    end

    for _, p in ipairs(Workspace:GetDescendants()) do
        if p:IsA("ProximityPrompt") and p.Enabled and p.Parent then
            local pp
            if p.Parent:IsA("BasePart") then pp = p.Parent.Position
            elseif p.Parent:IsA("Model") then
                local ok2, cf = pcall(function() return p.Parent:GetPivot() end)
                pp = ok2 and cf.Position or nil
            end
            if pp and (pp - baseCFrame.Position).Magnitude < 20 then
                local n = string.lower(tostring(p.ActionText) .. " " .. tostring(p.Name))
                if string.find(n, "place") or string.find(n, "plant") or string.find(n, "drop") then
                    if fireproximityprompt then
                        pcall(fireproximityprompt, p)
                        task.wait(0.25)
                        if not HasItemAcquired() then return true end
                    end
                end
            end
        end
    end
    return false
end

