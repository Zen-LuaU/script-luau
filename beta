                        InvokeRemote("WearTool", targetEgg.uid)
                        task.wait(0.15)
                        if HasItemAcquired() then break end
                    end
                end

                if not HasItemAcquired() then
                    FailUids[targetEgg.uid] = (FailUids[targetEgg.uid] or 0) + 1
                    isFarmingMovement = false
                    return
                end

                -- =========================================================
                -- ⭐ VỀ BASE (FIXED: retry 2 lần + ForceGetUp nếu ragdoll)
                -- =========================================================
                local reachedBase = false
                local attempt = 0
                while attempt < 2 and not reachedBase do
                    attempt = attempt + 1
                    reachedBase = NonLagStepTeleport(baseCFrame, true, 20)
                    if not reachedBase then
                        -- Bị ragdoll giữa đường → cố đứng dậy
                        ForceGetUp()
                        WaitForGetUp(1)
                        if not HasItemAcquired() then
                            -- Thật sự mất trứng → bỏ
                            break
                        end
                        -- Vẫn có trứng → thử lại 1 lần
                    end
                end

                if not reachedBase then
                    FailUids[targetEgg.uid] = (FailUids[targetEgg.uid] or 0) + 1
                    pcall(function() InvokeRemote("DoffTool", targetEgg.uid) end)
                    isFarmingMovement = false
                    return
                end

                StandStillAtPosition(baseCFrame, 0.3)

                -- Đặt trứng
                local placed = false
                if HasItemAcquired() then
                    for _ = 1, 5 do
                        if PlaceEggAtSavedBase(targetEgg.uid, baseCFrame) then
                            placed = true
                            break
                        end
                        task.wait(0.2)
                        if not HasItemAcquired() then
                            placed = true
                            break
                        end
                    end
                else
                    placed = true
                end

                if placed then
                    FailUids[targetEgg.uid] = nil
                else
                    FailUids[targetEgg.uid] = (FailUids[targetEgg.uid] or 0) + 1
                    pcall(function() InvokeRemote("DoffTool", targetEgg.uid) end)
                end

                -- ⭐ Reset về Bước 1 sau khi xong
                firstRunDone = false
                firstRunStep = 0
                targetFoEggUid = nil
                DetachRagdollListener()
                ResetRagdollSignal()

                isFarmingMovement = false
            end)
        end
    end
end)

-- ===== Speed Bypass =====
local function ApplyNewBypassAndSpeed()
    local char = LocalPlayer.Character
    if not char then return false end
    local oldHum = char:FindFirstChildOfClass("Humanoid")
    if not oldHum then return false end

    if GameDefaultWalkSpeed == nil then
        GameDefaultWalkSpeed = oldHum.WalkSpeed
    end

    IsBypassing = true
    local targetSpeed = SpeedConfig.Enabled and SpeedConfig.Value or oldHum.WalkSpeed
    local cam = Workspace.CurrentCamera
    local camCFrame = cam and cam.CFrame

    local clone = oldHum:Clone()
    clone.Parent = char
    oldHum:Destroy()
    task.wait(0.15)

    local newHum = char:FindFirstChildOfClass("Humanoid")
    if newHum then
        Humanoid = newHum
        if cam then
            cam.CameraSubject = newHum
            if camCFrame then cam.CFrame = camCFrame end
        end
        newHum.WalkSpeed = targetSpeed
        pcall(function()
            newHum:SetStateEnabled(Enum.HumanoidStateType.Ragdoll, false)
            newHum:SetStateEnabled(Enum.HumanoidStateType.FallingDown, false)
            newHum:SetStateEnabled(Enum.HumanoidStateType.Physics, false)
            newHum:SetStateEnabled(Enum.HumanoidStateType.GettingUp, true)
        end)
    end
    task.wait(0.15)
    IsBypassing = false
    return true
end

