    IsBypassing = true
    local data = {}
    for _, prop in ipairs({
        "RigType","HipHeight","JumpPower","JumpHeight","UseJumpPower",
        "AutoRotate","MaxSlopeAngle","AutomaticScalingEnabled",
        "BreakJointsOnDeath","RequiresNeck","EvaluateStateMachine"
    }) do
        pcall(function() data[prop] = oldHum[prop] end)
    end
    local speed = oldHum.WalkSpeed

    pcall(function() oldHum:Destroy() end)
    RunService.Heartbeat:Wait()

    local hum = Instance.new("Humanoid")
    for k, v in pairs(data) do pcall(function() hum[k] = v end) end
    hum.Parent = char
