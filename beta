-- ===== Get Target Egg (theo filter) =====
function GetTargetEgg()
    local snapshot = InvokeRemote("EggSnapshot")
    local records = snapshot and snapshot.Records
    if type(records) ~= "table" then return nil end

    local bestEgg, highestRank = nil, -1

    for _, eggData in pairs(records) do
        if not (eggData.State == "Slot" and eggData.Uid) then continue end
        local slotPart = GetEggSlotPart(eggData.Uid)
        local position = slotPart and slotPart.Position
            or ((eggData.BoundsCFrame or eggData.BottomCFrame) and (eggData.BoundsCFrame or eggData.BottomCFrame).Position)
        if not position then continue end

        local areaId = eggData.AreaId or "Unknown"
        local rarityObj = eggData.Rarity or (eggData.RarityName or (eggData.Tier or eggData.RarityId))
        if type(rarityObj) == "table" then
            rarityObj = rarityObj.DisplayName or (rarityObj._id or (rarityObj.Name or rarityObj.Id))
        end
        local rarityName = type(rarityObj) == "string" and rarityObj or "Common"
        local rank = RarityRank(rarityName)

        local areaMatch = true
        if AreaWantedCount > 0 then
            areaMatch = AreaWanted[areaId] == true or AreaWanted[string.lower(tostring(areaId))] == true
        end
        local rarityMatch = true
        if RarityWantedCount > 0 then
            rarityMatch = RarityWanted[rarityName] == true or RarityWanted[string.lower(tostring(rarityName))] == true
        end
        if FarmEggConfig.SecretPriority and rank >= (RarityLadder["Secret"] or 8) then rarityMatch = true end

        local tried = TriedUids[eggData.Uid]
        if tried then
            local fails = FailUids[eggData.Uid] or 0
            local wait = 6
            if fails >= 4 then wait = 600
            elseif fails == 3 then wait = 120
            elseif fails == 2 then wait = 45
            elseif fails == 1 then wait = 18 end
            if wait > tick() - tried then continue end
        end

        if areaMatch and rarityMatch and rank > highestRank then
            highestRank = rank
            bestEgg = { uid = eggData.Uid, pos = position, rarity = rarityName, area = areaId, rank = rank, slotPart = slotPart }
        end
    end
    return bestEgg
end

-- ===== Chọn trứng theo khu vực =====
local function ChooseEggByArea(forceArea)
    local snapshot = InvokeRemote("EggSnapshot")
    local records = snapshot and snapshot.Records
    if type(records) ~= "table" then return nil end

    local best, bestScore
    local forceLower = string.lower(tostring(forceArea or ""))

    for _, eggData in pairs(records) do
        if not (eggData.State == "Slot" and eggData.Uid) then continue end
        local slotPart = GetEggSlotPart(eggData.Uid)
        local position = slotPart and slotPart.Position
            or ((eggData.BoundsCFrame or eggData.BottomCFrame) and (eggData.BoundsCFrame or eggData.BottomCFrame).Position)
        if not position then continue end

        local areaId = eggData.AreaId or ""
        local label = AreaLabels[areaId] or areaId or ""
        local areaLower = string.lower(tostring(areaId))
        local labelLower = string.lower(tostring(label))

        local wanted = (labelLower == forceLower) or (areaLower == forceLower)
            or (string.find(labelLower, forceLower, 1, true) ~= nil)
            or (string.find(areaLower, forceLower, 1, true) ~= nil)

        if wanted then
            local rarityObj = eggData.Rarity or (eggData.RarityName or (eggData.Tier or eggData.RarityId))
            if type(rarityObj) == "table" then
                rarityObj = rarityObj.DisplayName or (rarityObj._id or (rarityObj.Name or rarityObj.Id))
            end
            local rarityName = type(rarityObj) == "string" and rarityObj or "Common"
            local rank = RarityRank(rarityName)
            local root = GetCurrentHRP()
            local dist = root and (position - root.Position).Magnitude or 0
            local score = rank * 1e12 - dist

            if not bestScore or score > bestScore then
                best = { uid = eggData.Uid, pos = position, rarity = rarityName, area = areaId, label = label, rank = rank }
                bestScore = score
            end
        end
    end
    return best
end

