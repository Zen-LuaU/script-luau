-- ============================================================
-- ⭐ TELEPORT TỪNG NẤC (FIXED) — Không đứng yên khi ragdoll
-- Mỗi bước: ForceGetUp() để chống ragdoll
-- Nếu checkDrop fail: thử re-grab 1 lần trước khi bỏ
-- ============================================================
local function NonLagStepTeleport(targetCFrame, checkDrop, timeoutSec)
    local char = LocalPlayer.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    local hum = char and char:FindFirstChildWhichIsA("Humanoid")
    if not hrp or not hum then return false end

    local stepSize = FarmEggConfig.TeleportStep or 18
    local stepDelay = FarmEggConfig.TeleportDelay or 0.04
    local startPos = hrp.Position
    local targetPos = targetCFrame.Position
    local dist = (targetPos - startPos).Magnitude

    if dist <= 3 then
        pcall(function() hrp.CFrame = targetCFrame end)
        return true
    end

    local dir = (targetPos - startPos).Unit
    local totalSteps = math.ceil(dist / stepSize)
    local success = true
    local startT = tick()
    timeoutSec = timeoutSec or 20
    local dropRetried = 0

    for i = 1, totalSteps do
        if not FarmEggConfig.AutoSteal then success = false; break end
        if tick() - startT > timeoutSec then success = false; break end

        -- ⭐ Chống ragdoll MỖI BƯỚC: không cho đứng yên
        ForceGetUp()

        -- ⭐ Nếu checkDrop fail: thử re-grab trước khi bỏ
        if checkDrop and not HasItemAcquired() then
            if dropRetried < 2 then
                dropRetried = dropRetried + 1
                -- Thử re-grab từ xa (server có thể vẫn giữ tool ảo)
                task.wait(0.15)
                if not HasItemAcquired() then
                    ForceGetUp()
                    task.wait(0.2)
                end
                if not HasItemAcquired() then
                    success = false
                    break
                end
            else
                success = false
                break
            end
        end

        local currentDist = math.min(i * stepSize, dist)
        local nextPos = startPos + (dir * currentDist)

        pcall(function()
            hrp.AssemblyLinearVelocity = Vector3.zero
            hrp.AssemblyAngularVelocity = Vector3.zero
            hrp.CFrame = CFrame.new(nextPos, nextPos + dir)
        end)

        RunService.Heartbeat:Wait()
        if stepDelay > 0 then task.wait(stepDelay) end
    end

    pcall(function() hum:ChangeState(Enum.HumanoidStateType.Freefall) end)

    if success then
        pcall(function()
            hrp.CFrame = targetCFrame
            hrp.AssemblyLinearVelocity = Vector3.zero
        end)
    end
    return success
end

