local function TableToArray(t)
    local out = {}
    if type(t) == "table" then
        for k, v in pairs(t) do
            if v == true then table.insert(out, k)
            elseif type(v) == "string" then table.insert(out, v) end
        end
    elseif type(t) == "string" then
        table.insert(out, t)
    end
    return out
end

local function UpdateAreaFilter(selected)
    local arr = TableToArray(selected)
    AreaWanted = {}
    AreaWantedCount = 0
    for _, label in ipairs(arr) do
        local id = AreaByLabel[label] or label
        AreaWanted[id] = true
        AreaWantedCount = AreaWantedCount + 1
    end
end

local function UpdateRarityFilter(selected)
    local arr = TableToArray(selected)
    RarityWanted = {}
    RarityWantedCount = 0
    for _, r in ipairs(arr) do
        RarityWanted[r] = true
        RarityWantedCount = RarityWantedCount + 1
    end
end

