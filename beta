local function MoveToTarget(target, timeout)
    local hrp = GetCurrentHRP()
    if not hrp then return false end
    timeout = timeout or 20
    local start = tick()
    local method = FarmEggConfig.FarmMethod

    while tick() - start < timeout and FarmEggConfig.AutoSteal do
        hrp = GetCurrentHRP()
        if not hrp then return false end
        local diff = target - hrp.Position
        local dist = diff.Magnitude
        if dist <= 5 then return true end

        local step = math.min(method == "TP Walk" and 45 or 60, dist)
        local dir = diff.Unit
        hrp.CFrame = CFrame.new(hrp.Position + dir * step) * CFrame.lookAt(Vector3.zero, Vector3.new(dir.X, 0, dir.Z))
        hrp.AssemblyLinearVelocity = Vector3.zero
        hrp.AssemblyAngularVelocity = Vector3.zero
        task.wait(method == "TP Walk" and 0.08 or 0.03)
    end
    hrp = GetCurrentHRP()
    if not hrp then return false end
    return (target - hrp.Position).Magnitude <= 10
end

